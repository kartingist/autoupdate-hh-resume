# ==========================================
# HH Resume Auto-Updater Environment Config
# ==========================================

# Base installation directory (defaults to script directory if empty/omitted)
HH_BASE_DIR=/home/user/autoupdate-hh-resume

# Optional custom Python venv path
# HH_VENV_PYTHON=/home/user/autoupdate-hh-resume/venv/bin/python

# HeadHunter Account Credentials
HH_EMAIL=your_email@example.com
HH_PASSWORD=your_password_here

# Web Dashboard Port
HH_DASHBOARD_PORT=8883
